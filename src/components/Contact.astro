---
---

<section id="contact" class="px-6 py-32 border-t border-border">
  <div class="max-w-6xl mx-auto">

    <div class="flex items-center gap-3 mb-16">
      <span class="block w-8 h-px bg-accent"></span>
      <span class="font-mono text-xs text-muted tracking-widest uppercase">Contact</span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-end">

      <div>
        <h2 class="font-display font-bold leading-none tracking-tight mb-6" style="font-size: clamp(2.5rem, 6vw, 5rem);">
          Let's work<br/>
          <span class="text-accent">together.</span>
        </h2>
        <p class="text-muted leading-relaxed max-w-md">
          Open to backend, full-stack, and remote positions.
          Best reached by email.
        </p>
      </div>

      <div class="space-y-4">
        <a
          href="mailto:zakaria.elarfaoui2105@gmail.com"
          class="group flex items-center justify-between border border-border p-5 hover:border-accent transition-colors"
        >
          <div>
            <span class="font-mono text-xs text-muted block mb-1 tracking-wider uppercase">Email</span>
            <span class="font-display font-medium text-ink group-hover:text-accent transition-colors">
              zakaria.elarfaoui2105@gmail.com
            </span>
          </div>
          <svg class="w-5 h-5 text-muted group-hover:text-accent group-hover:translate-x-1 transition-all" viewBox="0 0 24 24" fill="none">
            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>

        <a
          href="https://linkedin.com/in/zakaria-el-arfaoui" target="_blank" rel="noopener"
          class="group flex items-center justify-between border border-border p-5 hover:border-accent transition-colors"
        >
          <div>
            <span class="font-mono text-xs text-muted block mb-1 tracking-wider uppercase">LinkedIn</span>
            <span class="font-display font-medium text-ink group-hover:text-accent transition-colors">
              zakaria-el-arfaoui
            </span>
          </div>
          <svg class="w-5 h-5 text-muted group-hover:text-accent group-hover:translate-x-1 transition-all" viewBox="0 0 24 24" fill="none">
            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>

        <a
          href="https://github.com/zakariaelarfaoui" target="_blank" rel="noopener"
          class="group flex items-center justify-between border border-border p-5 hover:border-accent transition-colors"
        >
          <div>
            <span class="font-mono text-xs text-muted block mb-1 tracking-wider uppercase">GitHub</span>
            <span class="font-display font-medium text-ink group-hover:text-accent transition-colors">
              zakariaelarfaoui
            </span>
          </div>
          <svg class="w-5 h-5 text-muted group-hover:text-accent group-hover:translate-x-1 transition-all" viewBox="0 0 24 24" fill="none">
            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

    </div>

    <div class="mt-24 pt-8 border-t border-border flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <span class="font-mono text-xs text-muted">
        © {new Date().getFullYear()} Zakaria El Arfaoui
      </span>
    </div>

  </div>
</section>
